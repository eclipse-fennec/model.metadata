<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="metadata" nsURI="https://eclipse.org/fennec/metadata/1.0.0"
    nsPrefix="metadata">
  <eAnnotations source="Version">
    <details key="value" value="1.0"/>
  </eAnnotations>
  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="complianceLevel" value="17.0"/>
    <details key="oSGiCompatible" value="true"/>
    <details key="basePackage" value="org.eclipse.fennec.model"/>
    <details key="resource" value="XMI"/>
    <details key="copyrightText" value="Copyright (c) 2026 Contributors to the Eclipse Foundation.&#xA;&#xA;This program and the accompanying materials are made&#xA;available under the terms of the Eclipse Public License 2.0&#xA;which is available at https://www.eclipse.org/legal/epl-2.0/&#xA;&#xA;SPDX-License-Identifier: EPL-2.0&#xA;&#xA;Contributors:&#xA;  Data In Motion Consulting - initial implementation"/>
  </eAnnotations>
  <eClassifiers xsi:type="ecore:EEnum" name="DiagnosticSeverity">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Severity level for metadata diagnostics. Used by MetadataDiagnostic to classify annotation parsing issues and configuration validation problems."/>
    </eAnnotations>
    <eLiterals name="WARNING" literal="WARNING">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Non-fatal issue. The metadata element is usable but may not behave as intended. Examples: unrecognized annotation key (ignored), deprecated configuration."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="ERROR" value="1" literal="ERROR">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Fatal issue. The metadata element has an invalid configuration that will cause incorrect behavior. Examples: invalid key combination, annotation key used at wrong level."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="SerializationFormat">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Format strategy for serialization output. Controls whether metadata fields (type, ID, reference, supertype) are written as simple values or nested objects. Applies uniformly across all serialization targets."/>
    </eAnnotations>
    <eLiterals name="PLAIN" literal="PLAIN">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Simple value output. Writes a single string, number, or array of simple values. Example: {&quot;_type&quot;: &quot;http://example.org/model#//Person&quot;}"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="STRUCTURED" value="1" literal="STRUCTURED">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Nested object output with configurable keys. Example: {&quot;_type&quot;: {&quot;schema&quot;: &quot;http://example.org/model&quot;, &quot;name&quot;: &quot;Person&quot;}}"/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="TypeStrategy">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Strategy for serializing type information. Determines what kind of type identifier is written to the output for each EObject."/>
    </eAnnotations>
    <eLiterals name="NAME" literal="NAME">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Use the simple EClass name (e.g., 'Person'). Requires unique class names within the deserialization context."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="CLASS" value="1" literal="CLASS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Use the fully qualified Java instance class name (e.g., 'org.example.model.Person')."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="URI" value="2" literal="URI">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Use the full EMF EClass URI (e.g., 'http://example.org/model#//Person'). Most precise, always unique."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="SCHEMA_AND_TYPE" value="3" literal="SCHEMA_AND_TYPE">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Use separate top-level fields for schema (nsURI) and type (class name). Useful for formats that benefit from split metadata."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="NUMERIC" value="4" literal="NUMERIC">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Use numeric classifier IDs from the EPackage. Compact but fragile: IDs can change when the model evolves. Use only in controlled environments."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="NONE" value="5" literal="NONE">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="No type information serialized. For deserialization, the EClass must be provided via CODEC_ROOT_TYPE hint or be unambiguous from context."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="IdStrategy">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Strategy for determining which EStructuralFeatures form the serialized ID of an EObject."/>
    </eAnnotations>
    <eLiterals name="ID_FIELD" literal="ID_FIELD">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Use features marked with eID=true in the Ecore model. The standard EMF approach."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="COMBINED" value="1" literal="COMBINED">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Use explicitly specified features combined with a separator. The features and separator are configured via idFeatures and idSeparator annotation keys."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="IdKeyMode">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Controls how the ID value is represented in the serialized output. Determines whether a dedicated ID key, the original feature keys, or both are written."/>
    </eAnnotations>
    <eLiterals name="ID_ONLY" literal="ID_ONLY">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Only the dedicated ID key (e.g., '_id') is written. The original feature value is not duplicated under its feature name."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="BOTH" value="1" literal="BOTH">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Both the dedicated ID key and the original feature name(s) are written. Useful when consumers need both an ID field and the raw feature values."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="FEATURE_ONLY" value="2" literal="FEATURE_ONLY">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Only the original feature name(s) are written, no dedicated ID key. The ID is implicit from the feature values."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="NONE" value="3" literal="NONE">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="No ID output at all. Both the dedicated ID key and the feature-based ID are suppressed entirely."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="SuperTypeSelection">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Controls which supertypes of an EClass are included when supertype information is serialized."/>
    </eAnnotations>
    <eLiterals name="ALL" literal="ALL">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="All domain model supertypes in the inheritance hierarchy. Excludes EMF infrastructure classes (EObject, etc.)."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="ALL_EMF" value="1" literal="ALL_EMF">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="All supertypes including EMF base classes (EObject, etc.). Use when full type hierarchy is needed."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="SINGLE" value="2" literal="SINGLE">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Only the immediate/direct supertype. Reduces output size when only the parent type is relevant."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="NONE" value="3" literal="NONE">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="No supertype information serialized."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="EnumSerializationStrategy">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Strategy for serializing EEnum values. Controls whether the literal string, ordinal value, or programmatic name is used in the output."/>
    </eAnnotations>
    <eLiterals name="LITERAL" literal="LITERAL">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Use the enum literal string (e.g., 'ACTIVE'). This is the default and matches EMF's native representation."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="VALUE" value="1" literal="VALUE">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Use the enum ordinal value (e.g., 1). Compact but fragile: ordinals change when enum literals are reordered."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="NAME" value="2" literal="NAME">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Use the enum instance name (e.g., 'Active'). Differs from LITERAL when the literal string differs from the instance name."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="MetadataDiagnostic">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Diagnostic message for issues detected during metadata construction, annotation parsing, or configuration validation. Contained by the metadata element or aspect where the issue was detected."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="severity" eType="#//DiagnosticSeverity"
        defaultValueLiteral="WARNING">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Severity level of this diagnostic (WARNING or ERROR)."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="message" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Human-readable description of the issue."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="key" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The annotation key that caused the issue, if applicable. Null for diagnostics not related to a specific annotation key."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DiagnosticContainer" abstract="true"
      interface="true">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Interface for metadata elements that can contain diagnostics. Implemented by PackageMetadata, ClassMetadata, and FeatureMetadata. Provides both direct diagnostics and aggregated diagnostics from the containment subtree."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="diagnostics" upperBound="-1"
        eType="#//MetadataDiagnostic" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Diagnostics directly owned by this metadata element. Does not include diagnostics from contained children or aspects."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="allDiagnostics" upperBound="-1"
        eType="#//MetadataDiagnostic" changeable="false" volatile="true" transient="true"
        derived="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="All diagnostics from this element and its contained metadata subtree. For FeatureMetadata: same as diagnostics (leaf node). For ClassMetadata: own diagnostics + all feature diagnostics. For PackageMetadata: own diagnostics + all class allDiagnostics. Note: Aspect diagnostics are managed separately and not aggregated here."/>
        <details key="get" value="&lt;%org.eclipse.emf.common.util.EList%>&lt;&lt;%org.eclipse.fennec.model.metadata.MetadataDiagnostic%>> result = new &lt;%org.eclipse.emf.common.util.BasicEList%>&lt;>();&#xA;result.addAll(getDiagnostics());&#xA;&lt;%org.eclipse.emf.ecore.EClass%> eClassType = eClass();&#xA;if (eClassType == &lt;%org.eclipse.fennec.model.metadata.MetadataPackage%>.Literals.PACKAGE_METADATA) {&#xA;    for (&lt;%org.eclipse.fennec.model.metadata.ClassMetadata%> classMetadata : ((&lt;%org.eclipse.fennec.model.metadata.PackageMetadata%>) this).getClasses()) {&#xA;        result.addAll(classMetadata.getAllDiagnostics());&#xA;    }&#xA;} else if (eClassType == MetadataPackage.Literals.CLASS_METADATA) {&#xA;    for (&lt;%org.eclipse.fennec.model.metadata.FeatureMetadata%> featureMetadata : ((&lt;%org.eclipse.fennec.model.metadata.ClassMetadata%>) this).getFeatures()) {&#xA;        result.addAll(featureMetadata.getAllDiagnostics());&#xA;    }&#xA;}&#xA;return result;"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="BaseTypeConfig" abstract="true">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Base configuration for type information serialization. Controls how EClass type identity is written to the output. Shared by class-level and reference-level type configurations."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="format" eType="#//SerializationFormat"
        defaultValueLiteral="PLAIN">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Output format for type information: PLAIN writes a single value, STRUCTURED writes a nested object with schema/name keys."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="strategy" eType="#//TypeStrategy"
        defaultValueLiteral="URI">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Type identification strategy. Determines what kind of type identifier is written (NAME, CLASS, URI, SCHEMA_AND_TYPE, NUMERIC, NONE)."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="typeKey" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="_type">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="JSON property name for the type field. Default is '_type'."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="schemaKey" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="schema">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="JSON property name for the schema (nsURI) when using STRUCTURED format or SCHEMA_AND_TYPE strategy. Default is 'schema'."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="nameKey" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="name">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="JSON property name for the type name inside a STRUCTURED type object. Default is 'name'."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="BaseIdConfig" abstract="true">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Base configuration for ID serialization. Controls how object identity is written to the output, including the ID strategy, key naming, and format."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="strategy" eType="#//IdStrategy"
        defaultValueLiteral="ID_FIELD">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Strategy for determining which features form the ID (ID_FIELD uses eID markers, COMBINED uses explicitly listed features). To disable ID serialization, use IdKeyMode.NONE instead."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="keyMode" eType="#//IdKeyMode"
        defaultValueLiteral="ID_ONLY">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Controls what keys appear in the output: ID_ONLY writes only the dedicated ID key, BOTH writes ID key and feature keys, FEATURE_ONLY writes only feature keys, NONE suppresses all ID output."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="format" eType="#//SerializationFormat"
        defaultValueLiteral="PLAIN">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Output format for the ID: PLAIN writes a single value, STRUCTURED writes a nested object with value/separator keys."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="idKey" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="_id">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="JSON property name for the dedicated ID field. Default is '_id'."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="separator" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="-">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Separator character for combining multiple ID feature values in COMBINED strategy. Default is '-'."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="onTop" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        defaultValueLiteral="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether the ID field appears before the type field in the serialized output. Default true (ID first). Useful for MongoDB where _id should be the first field for indexing."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="serializeSeparator" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        defaultValueLiteral="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether to include the separator character in STRUCTURED ID output. When true, the separator is written alongside the ID value, enabling deserialization without knowing the separator in advance."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="separatorKey" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="separator">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="JSON property name for the separator field in STRUCTURED ID format. Default is 'separator'."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="valueKey" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="id">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="JSON property name for the ID value inside a STRUCTURED ID object. Default is 'id'."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="BaseReferenceConfig" abstract="true">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Base configuration for non-containment reference serialization. Controls how cross-references between EObjects are represented in the output."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="format" eType="#//SerializationFormat"
        defaultValueLiteral="PLAIN">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Output format for references: PLAIN writes a single reference value, STRUCTURED writes a nested object with type and reference keys."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="typeKey" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="_type">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="JSON property name for the type field inside a STRUCTURED reference object. Default is '_type'."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="refKey" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="_ref">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="JSON property name for the reference value inside a STRUCTURED reference object. Default is '_ref'."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="BaseSuperTypeConfig" abstract="true">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Base configuration for supertype information serialization. Controls whether and how the EClass inheritance hierarchy is included in the output. Supertype serialization is a sub-aspect of type serialization and is implicitly disabled when type serialization is disabled."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="enabled" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        defaultValueLiteral="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether supertype information is serialized. Default is false (supertypes are not written)."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="selection" eType="#//SuperTypeSelection"
        defaultValueLiteral="ALL">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Which supertypes to include when enabled: ALL (domain types only), ALL_EMF (including EObject etc.), SINGLE (direct parent only), NONE."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="format" eType="#//SerializationFormat"
        defaultValueLiteral="PLAIN">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Output format for supertype entries. Inherits from the parent type configuration format if not explicitly set."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="asArray" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        defaultValueLiteral="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether to write supertypes as a JSON array (true) or as a separator-joined string (false). Default is true (array)."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="separator" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral=",">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Separator character when asArray=false. Default is comma. Only used when supertypes are joined into a single string."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="superTypeKey" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="_supertype">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="JSON property name for supertype information. In PLAIN format, this is a top-level field. In STRUCTURED format, this is a key inside the type object. Default is '_supertype'."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="BaseFeatureConfig" abstract="true">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Base configuration for EStructuralFeature serialization. Controls visibility, key naming, null/empty/default handling, and enum strategy for individual features. These settings can be configured per-feature via EAnnotations or globally via runtime options."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="key" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Custom JSON property name for this feature. When null, the feature name (or extendedMetaDataName if useNamesFromExtendedMetadata is enabled) is used."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ignore" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Skip this feature for both serialization and deserialization. Null means false (not ignored). Set to true to make the feature invisible to the codec in both directions."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ignoreRead" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Skip this feature during deserialization only. Null means false. Set to true to prevent reading this feature from input while still writing it to output."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ignoreWrite" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Skip this feature during serialization only. Null means false. Set to true to prevent writing this feature to output while still reading it from input."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="forceRead" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Force deserialization of EMF transient/volatile features. Null means false. Set to true to override the default skipping of transient/volatile features during deserialization."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="forceWrite" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Force serialization of EMF transient/volatile/derived features. Null means false. Set to true to override the default skipping of transient/volatile/derived features during serialization."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="serializeNull" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether to write this feature when its value is null. Null means use the codec-level default. When true, null values are explicitly written (e.g., {&quot;name&quot;: null})."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="serializeEmpty" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether to write this feature when its collection value is empty. Null means use the codec-level default. When true, empty collections are explicitly written (e.g., {&quot;items&quot;: []})."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="serializeDefaults" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether to write this feature when its value equals the EMF default value. Null means use the codec-level default. When false, features with default values are omitted from output."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="enumSerialization" eType="#//EnumSerializationStrategy">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Strategy for serializing enum-typed features (LITERAL, VALUE, or NAME). Null means use LITERAL as default."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Aspect" abstract="true">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Base class for all aspects. An aspect represents a cross-cutting concern (e.g., codec, ORM, history) attached to model metadata. Aspects are created by AspectProviders during package registration and contained by their respective metadata elements (PackageMetadata, ClassMetadata, or FeatureMetadata)."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="typeId" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Unique identifier for the aspect type (e.g., 'codec', 'orm', 'history'). Set by the MetadataService from the AspectProvider's getAspectTypeId() value. Used to look up specific aspects by type."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="diagnostics" upperBound="-1"
        eType="#//MetadataDiagnostic" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Diagnostics collected during aspect creation (e.g., annotation parsing warnings, invalid key combinations). Managed separately from the metadata element's own diagnostics."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PackageAspect" abstract="true" eSuperTypes="#//Aspect">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Base class for aspects attached to PackageMetadata. Provides a bidirectional reference to the owning PackageMetadata, enabling navigation from the aspect back to the metadata context."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="packageMetadata" eType="#//PackageMetadata"
        eOpposite="#//PackageMetadata/aspects">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The PackageMetadata that contains this aspect. Bidirectional opposite of PackageMetadata.aspects. Use packageMetadata.getEPackage() to access the original EPackage."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ClassAspect" abstract="true" eSuperTypes="#//Aspect">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Base class for aspects attached to ClassMetadata. Provides a bidirectional reference to the owning ClassMetadata, enabling navigation from the aspect back to the metadata context and its feature tree."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="classMetadata" eType="#//ClassMetadata"
        eOpposite="#//ClassMetadata/aspects">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The ClassMetadata that contains this aspect. Bidirectional opposite of ClassMetadata.aspects. Use classMetadata.getEClass() to access the original EClass. Navigate classMetadata.getFeatures() to access feature metadata and their aspects."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="FeatureAspect" abstract="true" eSuperTypes="#//Aspect">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Base class for aspects attached to FeatureMetadata. Provides a bidirectional reference to the owning FeatureMetadata, enabling navigation from the aspect back to the metadata context and up to the class level."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="featureMetadata" eType="#//FeatureMetadata"
        eOpposite="#//FeatureMetadata/aspects">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The FeatureMetadata that contains this aspect. Bidirectional opposite of FeatureMetadata.aspects. Use featureMetadata.getEFeature() to access the original EStructuralFeature. Navigate featureMetadata.getClassMetadata() to reach the owning class."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="OperationAspect" abstract="true" eSuperTypes="#//Aspect">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Base class for aspects attached to OperationMetadata. Provides a bidirectional reference to the owning OperationMetadata, enabling navigation from the aspect back to the metadata context and up to the class level."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="operationMetadata" eType="#//OperationMetadata"
        eOpposite="#//OperationMetadata/aspects">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The OperationMetadata that contains this aspect. Bidirectional opposite of OperationMetadata.aspects. Use operationMetadata.getEOperation() to access the original EOperation. Navigate operationMetadata.getClassMetadata() to reach the owning class."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PackageProfile" abstract="true">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Base class for pre-computed, provider-specific profiles at the package level. A profile aggregates the fully resolved annotation-layer configuration for all classes in a package. Built by AspectProvider.buildProfiles() after all metadata and aspects are constructed. Concrete subclasses (e.g., CodecPackageProfile) contain provider-specific content. Contained by PackageMetadata.profiles (one per provider)."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="typeId" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Identifier of the AspectProvider that built this profile (e.g., 'codec', 'orm'). Matches the provider's getAspectTypeId() value. Used to look up profiles by provider type."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="classProfiles" upperBound="-1"
        eType="#//ClassProfile" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Pre-computed profiles for each EClass in the package. One ClassProfile per EClass that the provider is interested in."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ClassProfile" abstract="true">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Base class for pre-computed, provider-specific profiles at the class level. Contains the fully resolved annotation-layer configuration for an EClass and all its features, with annotation-internal inheritance already applied (feature inherits from class, class inherits from package defaults). Concrete subclasses (e.g., CodecClassProfile) provide provider-specific configuration, forward/reverse key mappings, and feature serialization order. At runtime, the profile serves as the static base that dynamic configuration (options, resource, factory, module) merges on top of."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="eClass" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EClass">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The EClass this profile describes. Used to look up the profile by EClass identity."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PackageMetadata" eSuperTypes="#//DiagnosticContainer">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Pre-computed metadata for an EPackage. Root of the metadata tree for a package, containing ClassMetadata for all EClasses, aspects from all registered AspectProviders, and profiles built by providers. Created by MetadataService.registerPackage() and indexed for fast lookups."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ePackage" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EPackage">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The EPackage this metadata describes."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="nsURI" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Cached namespace URI of the EPackage. Used for fast lookup without dereferencing the EPackage."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="classes" upperBound="-1"
        eType="#//ClassMetadata" containment="true" eOpposite="#//ClassMetadata/package">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Metadata for all EClasses in this package. Bidirectional: each ClassMetadata has a back-reference via ClassMetadata.package."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="aspects" upperBound="-1"
        eType="#//PackageAspect" containment="true" eOpposite="#//PackageAspect/packageMetadata">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Aspects attached to this package by registered AspectProviders. One aspect per provider (identified by typeId). Bidirectional: each PackageAspect has a back-reference via PackageAspect.packageMetadata."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="profiles" upperBound="-1"
        eType="#//PackageProfile" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Pre-computed profiles built by AspectProviders. One profile per provider (identified by typeId). Profiles contain the fully resolved annotation-layer configuration for all classes. Built after all metadata, aspects, and cross-references are complete."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ClassMetadata" eSuperTypes="#//DiagnosticContainer">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Pre-computed metadata for an EClass. Contains cached properties for fast access, feature metadata for all EStructuralFeatures, pre-resolved supertype and ID information, and aspects from all registered AspectProviders. Contained by PackageMetadata."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="package" eType="#//PackageMetadata"
        eOpposite="#//PackageMetadata/classes">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The parent PackageMetadata. Bidirectional opposite of PackageMetadata.classes. Navigate to package.getEPackage() to access the original EPackage."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="eClass" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EClass">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The EClass this metadata describes."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Cached EClass name. Avoids repeated eClass.getName() calls during serialization and index lookups."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="classifierID" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        defaultValueLiteral="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Cached EClassifier ID from the EPackage. Used by NUMERIC TypeStrategy for compact type serialization. Value -1 indicates uninitialized."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="typeURI" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Pre-computed full type URI in the form 'nsURI#//className'. Used by URI TypeStrategy for type serialization. Computed once at registration time to avoid string concatenation during serialization."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="features" upperBound="-1"
        eType="#//FeatureMetadata" containment="true" eOpposite="#//FeatureMetadata/classMetadata">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Metadata for all EStructuralFeatures of this EClass. Bidirectional: each FeatureMetadata has a back-reference via FeatureMetadata.classMetadata. Order matches the EClass feature order."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="operations" upperBound="-1"
        eType="#//OperationMetadata" containment="true" eOpposite="#//OperationMetadata/classMetadata">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Metadata for all EOperations of this EClass. Bidirectional: each OperationMetadata has a back-reference via OperationMetadata.classMetadata. Order matches the EClass operation order."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="superTypes" upperBound="-1"
        eType="#//ClassMetadata">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Pre-resolved metadata for the direct supertypes of this EClass. Resolved during package registration after all ClassMetadata are created."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="allSuperTypes" upperBound="-1"
        eType="#//ClassMetadata">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Pre-resolved metadata for all supertypes in the full inheritance hierarchy (transitive closure). Resolved during package registration."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="idFeatures" upperBound="-1"
        eType="#//FeatureMetadata">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Pre-resolved features that form the object ID, in order. For ID_FIELD strategy: features with eID=true. For COMBINED strategy: explicitly configured features. Empty when IdKeyMode is NONE."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="hasId" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        defaultValueLiteral="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether this EClass has at least one ID feature (eID=true). Quick check to avoid iterating features during serialization."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="aspects" upperBound="-1"
        eType="#//ClassAspect" containment="true" eOpposite="#//ClassAspect/classMetadata">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Aspects attached to this class by registered AspectProviders. One aspect per provider (identified by typeId). Bidirectional: each ClassAspect has a back-reference via ClassAspect.classMetadata."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="FeatureMetadata" abstract="true" eSuperTypes="#//DiagnosticContainer">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Abstract base class for pre-computed metadata about an EStructuralFeature. Contains cached properties for fast access and aspects from registered AspectProviders. Concrete subclasses: AttributeMetadata (for EAttribute) and ReferenceMetadata (for EReference). Contained by ClassMetadata.features."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="classMetadata" eType="#//ClassMetadata"
        eOpposite="#//ClassMetadata/features">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The parent ClassMetadata. Bidirectional opposite of ClassMetadata.features. Navigate to classMetadata.getPackage() to reach the PackageMetadata."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="eFeature" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The EStructuralFeature this metadata describes."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Cached feature name. Avoids repeated eFeature.getName() calls during serialization."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="extendedMetaDataName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Alternative name from EMF ExtendedMetaData annotation (source: http://www.eclipse.org/emf/2002/Ecore). Present in XSD-generated models where the XML element/attribute name differs from the Java-friendly EMF feature name. Null if no ExtendedMetaData 'name' annotation exists."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="featureID" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        defaultValueLiteral="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Cached feature ID from the EClass. Used for fast feature lookup by numeric ID. Value -1 indicates uninitialized."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="aspects" upperBound="-1"
        eType="#//FeatureAspect" containment="true" eOpposite="#//FeatureAspect/featureMetadata">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Aspects attached to this feature by registered AspectProviders. One aspect per provider (identified by typeId). Bidirectional: each FeatureAspect has a back-reference via FeatureAspect.featureMetadata."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AttributeMetadata" eSuperTypes="#//FeatureMetadata">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Pre-computed metadata for an EAttribute. Extends FeatureMetadata with attribute-specific properties such as eID status and cached default value."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="eAttribute" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EAttribute">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The EAttribute this metadata describes. Typed convenience reference (the base class eFeature also holds this value as EStructuralFeature)."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="isId" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        defaultValueLiteral="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether this EAttribute is marked as eID in the Ecore model. Cached for fast ID feature resolution."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="defaultValue" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EJavaObject">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Cached default value of the EAttribute. Used for serializeDefaults comparison to avoid computing the default on every serialization call."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ReferenceMetadata" eSuperTypes="#//FeatureMetadata">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Pre-computed metadata for an EReference. Extends FeatureMetadata with reference-specific properties such as containment status, target class resolution, and bidirectional opposite resolution."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="eReference" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EReference">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The EReference this metadata describes. Typed convenience reference (the base class eFeature also holds this value as EStructuralFeature)."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="containment" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        defaultValueLiteral="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether this is a containment reference. Containment references own the target object (inline serialization), non-containment references point to objects owned elsewhere (reference serialization)."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="targetClassMetadata" eType="#//ClassMetadata">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Pre-resolved metadata for the target EClass of this reference. Resolved during package registration after all ClassMetadata are created. May be null if the target class is in an unregistered package."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="oppositeMetadata" eType="#//ReferenceMetadata">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Pre-resolved metadata for the opposite EReference in a bidirectional association. Null if this reference has no opposite. Resolved during package registration."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="hasBidirectional" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        defaultValueLiteral="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether this reference has an opposite reference (is part of a bidirectional association). Quick check to avoid null-checking oppositeMetadata during serialization."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="OperationMetadata" eSuperTypes="#//DiagnosticContainer">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Pre-computed metadata for an EOperation. Contains cached properties for fast access, the resolved return-type metadata, parameter metadata for all EParameters, and aspects from all registered AspectProviders. Contained by ClassMetadata.operations."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="classMetadata" eType="#//ClassMetadata"
        eOpposite="#//ClassMetadata/operations">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The parent ClassMetadata. Bidirectional opposite of ClassMetadata.operations. Navigate to classMetadata.getPackage() to reach the PackageMetadata."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="eOperation" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EOperation">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The EOperation this metadata describes."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Cached operation name. Avoids repeated eOperation.getName() calls."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="operationID" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        defaultValueLiteral="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Cached operation ID from the EClass. Used for fast operation lookup by numeric ID. Value -1 indicates uninitialized."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="returnTypeMetadata" eType="#//ClassMetadata">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Pre-resolved metadata for the EOperation return type, when the return EClassifier is an EClass in a registered package. Null for void operations, EDataType returns, or unregistered target packages. Resolved during package registration after all ClassMetadata are created."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="parameters" upperBound="-1"
        eType="#//ParameterMetadata" containment="true" eOpposite="#//ParameterMetadata/operationMetadata">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Metadata for all EParameters of this EOperation, in declaration order. Bidirectional: each ParameterMetadata has a back-reference via ParameterMetadata.operationMetadata."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="aspects" upperBound="-1"
        eType="#//OperationAspect" containment="true" eOpposite="#//OperationAspect/operationMetadata">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Aspects attached to this operation by registered AspectProviders. One aspect per provider (identified by typeId). Bidirectional: each OperationAspect has a back-reference via OperationAspect.operationMetadata."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ParameterMetadata" eSuperTypes="#//DiagnosticContainer">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Pre-computed metadata for an EParameter of an EOperation. Contains cached properties and the resolved parameter-type metadata. Contained by OperationMetadata.parameters."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="operationMetadata" eType="#//OperationMetadata"
        eOpposite="#//OperationMetadata/parameters">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The parent OperationMetadata. Bidirectional opposite of OperationMetadata.parameters."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="eParameter" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EParameter">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The EParameter this metadata describes."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Cached parameter name. Avoids repeated eParameter.getName() calls."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="typeMetadata" eType="#//ClassMetadata">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Pre-resolved metadata for the parameter type, when the parameter EClassifier is an EClass in a registered package. Null for EDataType parameters or unregistered target packages. Resolved during package registration."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="MetadataRegistry">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Root container for all pre-computed package metadata. Serves as the serializable root for persisting/caching the entire metadata state. Contains all PackageMetadata instances registered with the MetadataService."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="packages" upperBound="-1"
        eType="#//PackageMetadata" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="All registered PackageMetadata instances. Each PackageMetadata contains the complete metadata tree for one EPackage (classes, features, aspects, profiles)."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
</ecore:EPackage>
